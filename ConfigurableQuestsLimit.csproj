<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="game-libs/Versions.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Version>1.0.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameDirectory Condition="'$(GameDirectory)' == ''">D:\GAMES\SteamLibrary\steamapps\common\ATLYSS</GameDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Somepoi.Atlyss.GameLibs" Version="$(GameLibsVersion)" IncludeAssets="compile" PrivateAssets="all" />
    <!-- Download the official packages without their runtime dependency trees. -->
    <PackageDownload Include="BepInEx.BaseLib" Version="[$(BepInExVersion)]" />
    <PackageDownload Include="HarmonyX" Version="[$(HarmonyVersion)]" />
    <Reference Include="BepInEx" HintPath="$(NuGetPackageRoot)/bepinex.baselib/$(BepInExVersion)/lib/net35/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(NuGetPackageRoot)/harmonyx/$(HarmonyVersion)/lib/netstandard2.0/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core.cs" />
    <Compile Include="ConfigurableQuestsLimitSettings.cs" />
    <Compile Include="ConfigurableQuestsLimitPatches.cs" />
    <Compile Include="QuestJournalPatches.cs" />
    <Compile Include="QuestLogView.cs" />
    <Compile Include="QuestLogLayout.cs" />
    <Compile Include="QuestTrackerPagination.cs" />
    <Compile Include="QuestTrackerPatches.cs" />
    <Compile Include="QuestTrackerPager.cs" />
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')"
           Text="Reference not found: %(Reference.HintPath). Restore the pinned BepInEx/Harmony NuGet packages." />
  </Target>
  <Target Name="GenerateModVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)ModVersion.g.cs"
                      Lines="namespace ConfigurableQuestsLimit { internal static class ModVersion { internal const string Value = &quot;$(Version)&quot;%3B } }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ModVersion.g.cs" />
    </ItemGroup>
  </Target>
  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(GameDirectory)\BepInEx\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDirectory)\BepInEx\plugins" />
  </Target>
</Project>
